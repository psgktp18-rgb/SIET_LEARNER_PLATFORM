# ==============================================================================
# SIET LEARNER PLATFORM (Lecture Lens) - Environment Configuration
# ==============================================================================

# Database connection string (PostgreSQL via Neon / Supabase / Local Docker)
DATABASE_URL="postgresql://username:password@localhost:5432/lecture_lens?schema=public"

# Secret used to sign JSON Web Tokens (min 32 characters for security)
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"

# Encryption key for sensitive data in the database
ENCRYPTION_KEY="replace_with_32_byte_hex_encryption_key"

# Public URL of the application
APP_URL="http://localhost:3000"

# Application environment (development | test | production)
NODE_ENV="development"

# Maximum upload size in megabytes for classroom attachments & notes
MAX_UPLOAD_MB="10"

# Domain for the Jitsi Meet iframe
JITSI_DOMAIN="meet.jit.si"

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Primary AI Provider (ollama | gemini)
AI_PRIMARY="ollama"

# Fallback AI Provider (gemini | none)
AI_FALLBACK="gemini"

# Override for the ProviderRouter logic in testing (e.g. "router" or "mock")
AI_PROVIDER="router"

# Ollama local endpoint & models (used if Ollama is running)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen2.5:7b-instruct"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Google Gemini API Key & Model (Fallback or Primary)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# Timeout in milliseconds for AI requests before falling back
AI_TIMEOUT_MS="30000"

# ------------------------------------------------------------------------------
# Firebase Configuration (Client-side real-time / storage / notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your_project_id-default-rtdb.firebaseio.com"
